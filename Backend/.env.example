# Required
GROQ_API_KEY=your_groq_api_key_here

# Model Routing Configuration (Optional)
# Modes:
#   - 'quality'  (default): llama-3.3-70b-versatile for both analysis & copywriting, with 8b fallback
#   - 'balanced': llama-3.1-8b-instant for fast extraction/analysis, llama-3.3-70b-versatile for copywriting
#   - 'fast':     llama-3.1-8b-instant for both tasks (sub-second throughput)
GROQ_ROUTING_MODE=quality

# Fine-grained overrides (Optional)
# GROQ_ANALYZER_MODEL=llama-3.3-70b-versatile
# GROQ_WRITER_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
